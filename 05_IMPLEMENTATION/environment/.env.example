# AI Video Factory — Local Development Environment Configuration
# Copy this file to .env before starting services

# Application Environment
NODE_ENV=development
LOG_LEVEL=debug
APP_PORT=3000

# PostgreSQL (R02 Core State)
POSTGRES_USER=avf_dev
POSTGRES_PASSWORD=avf_dev_password
POSTGRES_DB=avf_canonical_state
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://avf_dev:avf_dev_password@localhost:5432/avf_canonical_state?schema=public

# Temporal Orchestrator (R06 Workflow)
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_UI_PORT=8088

# Object Storage / MinIO (S3 Compatible)
MINIO_ROOT_USER=avf_minio_admin
MINIO_ROOT_PASSWORD=avf_minio_password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=avf-video-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=avf_minio_admin
S3_SECRET_ACCESS_KEY=avf_minio_password
S3_FORCE_PATH_STYLE=true

# Provider SDK & Fake Provider (R07)
DEFAULT_VIDEO_PROVIDER=fake-provider
FAKE_PROVIDER_URL=http://localhost:8090
FAKE_PROVIDER_LATENCY_MS=500
FAKE_PROVIDER_FAILURE_RATE=0.0

# OpenTelemetry Collector (R14)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=avf-core

# Optional Live Google Flow Credentials (HOST LOCAL ONLY - NEVER COMMIT)
GOOGLE_FLOW_SESSION_COOKIE=
GOOGLE_FLOW_PROJECT_ID=
FLOWKIT_BRIDGE_URL=http://localhost:8095
