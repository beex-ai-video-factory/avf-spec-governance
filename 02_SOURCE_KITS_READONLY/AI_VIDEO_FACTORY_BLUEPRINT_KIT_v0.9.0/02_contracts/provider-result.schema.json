{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avf.local/contracts/provider-result/1.0",
  "title": "ProviderGenerationResult",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "provider",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "provider": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "GENERATING",
        "COMPLETED",
        "FAILED",
        "BLOCKED",
        "CANCELLED"
      ]
    },
    "provider_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "uri",
          "media_type"
        ]
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "provider_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
